# synthetic: hand-written from docs/device-protocol.md, not yet checked
# against hardware. Serial number and firmware version are made up; the
# bytes between the report ID and the string are unknown and left as 0.
model original

# The original's image reports are 8191 bytes.
write 02 00*8190

# Serial number "AL12H1A01234", firmware "1.0.170133".
feature-get 03 17 -> 03 00 00 00 00 41 4c 31 32 48 31 41 30 31 32 33 34
feature-get 04 17 -> 04 00 00 00 00 31 2e 30 2e 31 37 30 31 33 33 00 00

# Brightness 50 %.
feature-set 05 55 aa d1 01 32 00*11

# 1500-byte image on key 3. The original numbers keys right to left, so
# that's device key 1, sent 1-based as 2. Pages count from 1.
write 02 01 01 00 01 02 00*10 ab*1500 00*6675

# Key 0 (device index 4) down; key 14 (device index 10) down; key 0 up;
# key 14 up.
read 16 -> 01 00*4 01 00*10
read 16 -> 01 00*4 01 00*5 01 00*4
read 16 -> 01 00*10 01 00*4
read 16 -> 01 00*15

# Reset.
feature-set 0b 63 00*15
