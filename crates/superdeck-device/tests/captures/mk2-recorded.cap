# recorded: Stream Deck MK.2, firmware 1.02.000, by zHappySnake on
# 2026-10-10 with `superdeck-cli --record`. Three runs of the CLI, each
# opening the device again. The serial number is replaced with a dummy of
# the same length; everything else is as recorded.
model mk2

# `info`. Bytes 2-5 of the firmware report aren't zero on real hardware.
write 02 00*1023
feature-get 06 32 -> 06 0c 41 4c 31 32 4b 31 41 30 31 32 33 34 00*18
feature-get 05 32 -> 05 0c b2 cd b1 35 31 2e 30 32 2e 30 30 30 00*18

# `brightness 50`.
write 02 00*1023
feature-set 03 08 32 00*29

# `events`: key 0 pressed and released, then key 14, then key 0 and
# key 14 held together, key 14 released first.
write 02 00*1023
read 19 -> 01 00 0f 00 01 00*14
read 19 -> 01 00 0f 00*16
read 19 -> 01 00 0f 00*15 01
read 19 -> 01 00 0f 00*16
read 19 -> 01 00 0f 00 01 00*14
read 19 -> 01 00 0f 00 01 00*13 01
read 19 -> 01 00 0f 00 01 00*14
read 19 -> 01 00 0f 00*16
